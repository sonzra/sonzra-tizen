{
  "name": "sonzra-tizen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sonzra Samsung TV (Tizen) 10-foot Client",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "package:tizen": "npm run build && tizen package -t wgt -s SonzraSecurityProfile -- dist",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.8"
  }
}
