#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"

echo "=== [1/3] Typecheck & Asset Build ==="
npm run build

echo "=== [2/3] Running Unit & Spatial Navigation Tests ==="
npm test

echo "=== [3/3] Running Playwright E2E Spatial Navigation Tests ==="
npm run test:e2e

echo "✓ All Sonzra TV quality gates PASSED!"
